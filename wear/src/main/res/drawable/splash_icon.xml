<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash icon (themes.xml, LaunchLogo): the launcher icon itself, at the
  48x48dp on black that Wear review checks for ("Missing app icon in splash
  screen"), centred. Google's Wear splash recipe.

  The launcher icon and not a copy of its mark: review wants the same branding
  as the launcher, and the adaptive icon carries its own background, masked to
  the watch's circle as the launcher masks it. A fixed-size, centred item keeps
  it 48dp whatever size the system draws the splash icon at.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp"
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center" />
</layer-list>
