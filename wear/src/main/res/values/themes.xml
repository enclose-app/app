<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme.DeviceDefault with the system splash showing the app's mark on
      black, as Wear's quality guidelines require.

      By default the system draws the icon only for a start from the launcher;
      opened by anything else (Play's "Open" button, a notification, the phone)
      the splash is the background colour alone, which is what review kept
      rejecting. icon_preferred (API 33, our minSdk) asks for the icon on every
      start. LaunchLogo draws the same icon again as the app's first frame, for
      the one case this can't cover: a launcher that explicitly asks for a
      plain splash. Keep the two alike: same drawable, same black.
    -->
    <style name="Theme.Enclose" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
