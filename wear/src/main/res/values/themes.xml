<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme.DeviceDefault with the system splash showing the app's mark on
      black, as Wear's quality guidelines require. The system only draws the
      icon for a start from the launcher, so LaunchLogo draws the same one
      again as the app's first frame — see there. Keep the two alike: same
      drawable, same black.
    -->
    <style name="Theme.Enclose" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
