<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme.DeviceDefault with the system splash showing the app's mark on
      black. Wear's quality guidelines require the app icon on the splash (a
      blank one was rejected at review), so this is the only launch logo —
      MainActivity holds it until the phone's status has been read.
    -->
    <style name="Theme.Enclose" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
