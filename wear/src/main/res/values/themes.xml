<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme.DeviceDefault with a plain black system splash. Wear's splash shows
      its icon at a fixed 48dp, so the app draws its own, larger — see
      LaunchLogo. Leaving the system's icon in would show two logos in a row.
    -->
    <style name="Theme.Enclose" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
