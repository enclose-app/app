<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Map tiles, over the phone's connection or the watch's own. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The buzz when the loop becomes ready to close. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The tap-to-stop prompt that comes with it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          Not standalone: there is nothing here without the phone, which records
          the walk. Play uses this to require the phone app alongside.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hears the phone's status with the app closed, which is when the
          ready-to-close buzz matters most. Exported because Play Services
          delivers it; it only hears apps signed with the same key.
        -->
        <service
            android:name=".StatusListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/enclose/status" />
            </intent-filter>
        </service>
    </application>

</manifest>
