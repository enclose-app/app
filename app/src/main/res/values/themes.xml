<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The window theme only covers the moment before Compose draws, so it is the
      platform's own DayNight rather than Material Components'. That library was
      here for nothing but this parent, and it carries BottomSheetDialog,
      SheetDialog and EdgeToEdgeUtils, which call the Window bar-colour setters
      Play reports as deprecated in Android 15.
    -->
    <style name="Base.Theme.Enclose" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      Edge-to-edge is set up here rather than with enableEdgeToEdge(). That
      helper calls Window.setStatusBarColor/setNavigationBarColor, and before
      API 30 picks LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES: all deprecated in
      Android 15 and reported by Play even though they only run on older
      versions. From API 35 targetSdk enforces edge-to-edge and ignores these
      colours; on 33-34 they make the bars transparent, and MainActivity turns
      off decor fitting. Icon colour follows the system theme, as EncloseTheme
      does.
    -->
    <style name="Theme.Enclose" parent="Base.Theme.Enclose">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?android:attr/isLightTheme</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
