<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Enclose mark: the walked loop around claimed ground, with the start
         (solid) and the walker (open ring) about to close it. Drawn in the
         48-unit coordinates of play/icon.svg; the group maps that drawing's
         46-unit body onto the 72dp a launcher mask shows (scale 72/46), which
         keeps all of the art within ~25dp of the centre, inside the 33dp safe
         zone. Change play/icon.svg and this together. -->
    <group
        android:scaleX="1.5652"
        android:scaleY="1.5652"
        android:translateX="16.435"
        android:translateY="16.435">

        <!-- Claimed ground. -->
        <path
            android:fillAlpha="0.2"
            android:pathData="M12.5,30 L17,15.5 L31,11.5 L38.5,24 L33,36.5 L21.5,37.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="8"
                    android:startY="41"
                    android:endX="40"
                    android:endY="9">
                    <item android:color="#FF7B47F5" android:offset="0.0" />
                    <item android:color="#FFAE4FF8" android:offset="0.35" />
                    <item android:color="#FFDD59F8" android:offset="0.7" />
                    <item android:color="#FFFC73EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- The walked loop, from the start round to the walker. -->
        <path
            android:fillColor="#00000000"
            android:strokeAlpha="0.9"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M12.5,30 L17,15.5 L31,11.5 L38.5,24 L33,36.5 L25.1,37.2">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="8"
                    android:startY="41"
                    android:endX="40"
                    android:endY="9">
                    <item android:color="#FF7B47F5" android:offset="0.0" />
                    <item android:color="#FFAE4FF8" android:offset="0.35" />
                    <item android:color="#FFDD59F8" android:offset="0.7" />
                    <item android:color="#FFFC73EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Start: solid. -->
        <path android:pathData="M12.5,30 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="8"
                    android:startY="41"
                    android:endX="40"
                    android:endY="9">
                    <item android:color="#FF7B47F5" android:offset="0.0" />
                    <item android:color="#FFAE4FF8" android:offset="0.35" />
                    <item android:color="#FFDD59F8" android:offset="0.7" />
                    <item android:color="#FFFC73EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Walker: open. -->
        <path
            android:fillColor="#00000000"
            android:strokeWidth="2.4"
            android:pathData="M21.5,37.5 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0 Z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="8"
                    android:startY="41"
                    android:endX="40"
                    android:endY="9">
                    <item android:color="#FF7B47F5" android:offset="0.0" />
                    <item android:color="#FFAE4FF8" android:offset="0.35" />
                    <item android:color="#FFDD59F8" android:offset="0.7" />
                    <item android:color="#FFFC73EE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
