<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Map tiles -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS tracking -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Tells walking / running / cycling apart from driving, so a car trip can't
      claim territory. Optional: if declined, sustained-speed checks still apply.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Keep recording the walk while the app is backgrounded / screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Haptic cue when a loop becomes ready to close -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".EncloseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Enclose"
        tools:ignore="MissingClass">
        <!--
          resizeable + supportsPictureInPicture: the walk is worth watching while
          you use another app, in a split-screen half or in a floating window.

          configChanges covers every dimension a multi-window resize touches. Not
          for rotation's sake — for the map's: without it, entering or leaving
          split screen or PiP recreates the activity, which tears down the GL
          MapView and rebuilds it mid-walk. Compose re-reads the configuration on
          its own, so nothing here needs handling in code.

          launchMode=singleTask so the split-screen request (which relaunches
          this activity with FLAG_ACTIVITY_LAUNCH_ADJACENT) can never produce a
          second copy of the app on devices that ignore the flag; it is delivered
          to the running one as a new intent instead.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|uiMode|keyboardHidden|navigation"
            android:theme="@style/Theme.Enclose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.LocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Receives activity-recognition batches from Play Services. -->
        <receiver
            android:name=".tracking.ActivityUpdateReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Shares exported GPX/GeoJSON files from cacheDir via the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
